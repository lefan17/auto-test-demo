# 口令与密钥模板：复制成 `.env` 后填写本地值（`.env` 已被 .gitignore 忽略）。
#
# 用法（Windows PowerShell）：
#   Copy-Item .env.example .env
# 然后按需改里面的值。**不填也能跑**：不存在的键会回落到 common/secrets.py 里
# 登记过的「本地 Mock 默认口令」，那是 Mock 后端的种子口令，公开且只能用于本机。
#
# 三条规则：
# 1. 真实环境（staging/prod）的口令**只从这里或 CI secret 注入**，不要写进
#    data/config*.yaml，也不要写进任何入库文件；CI 上用 GitHub Secrets 设同名环境变量。
# 2. 这里的值是占位符，不是可用的口令。看到 `change-me` 说明该变量还没配。
# 3. 已存在的环境变量优先于本文件（common/secrets.py 的 load_dotenv 不覆盖），
#    所以在 CI 上注入 secret 不会被仓库里的 .env 顶掉。

# ---------- Mock MES 后端的角色口令 ----------
# 对应 mock_server/db.py 的种子账号；改这里，种子入库与用例登录会同时跟着变
# （两处取的都是 common/secrets.py 这一个来源）。
MES_PASSWORD_ADMIN=change-me-admin
MES_PASSWORD_PLANNER=change-me-planner
MES_PASSWORD_OPERATOR=change-me-operator
MES_PASSWORD_OPERATOR2=change-me-operator2
MES_PASSWORD_QA=change-me-qa

# ---------- UI 测试账号口令（saucedemo 是公开练习站）----------
# data/config.yaml 里写的是 ${UI_PASSWORD} / ${UI_WRONG_PASSWORD}，读取时展开。
UI_PASSWORD=change-me-ui
UI_WRONG_PASSWORD=change-me-ui-wrong

# ---------- Mock 服务的签名密钥与令牌有效期 ----------
# MOCK_SECRET 是签 JWT 用的密钥：本地随便填，真实环境必须换成随机值。
# MOCK_TOKEN_TTL 是令牌有效期（秒）。调小它（如 3）就能手工复现"令牌过期"。
MOCK_SECRET=change-me-mock-secret
MOCK_TOKEN_TTL=3600

# ---------- 客户端提前刷新窗口（秒）----------
# 令牌离到期还有这么长时间时就提前换新的，默认 60。取 0 表示"等真的过期再换"。
TOKEN_REFRESH_MARGIN_SECONDS=60

# ---------- 禅道（测试管理平台）上报凭据 ----------
# 只被 scripts/report_to_zentao.py 读取，且**只在显式加 --send 时**读；
# 不加 --send 就是 dry-run，脚本根本不碰这三个变量（也就不会因为没配而失败）。
#
# ZENTAO_TOKEN 是**真实凭据**：绝不入库、绝不进日志、绝不进产物
# （`--send` 的产物 reports/zentao-payload.json 里只有 payload，
# 认证头由请求头单独注入，不在产物里）。命令行**故意不提供**凭据参数，
# 避免它落进 shell 历史与进程表。生成方式：POST /api.php/v1/tokens。
#
# ZENTAO_PRODUCT 目前**未被脚本使用**（脚本按用例 ID 直接上报，产品 ID 只在建用例时才需要），
# 登记在这里是为了"建用例"那一步不必另找地方配。
ZENTAO_URL=change-me-zentao-url
ZENTAO_TOKEN=change-me-zentao-token
ZENTAO_PRODUCT=change-me-zentao-product-id
