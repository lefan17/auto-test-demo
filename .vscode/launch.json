{
  "version": "0.2.0",
  "configurations": [
    {
      // 调试单条用例：在这个 .py 文件里打断点，按 F5 选这个配置
      "name": "调试当前测试文件",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "-s"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "调试全部接口用例",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-m", "api", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      // 想看着浏览器操作，就用这个（对应 conftest 里 headless=False 的说明）
      "name": "调试全部 UI 用例（显示浏览器）",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-m", "ui", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PWDEBUG": "0" }
    }
  ]
}
